[Unit]
Description=SurfMind Celery worker (staging — background page classification)
After=network.target redis.service

[Service]
Type=simple
User=zain
WorkingDirectory=/home/zain/surfmind/surfmind-backend-staging
EnvironmentFile=/home/zain/surfmind/surfmind-backend-staging/.env
ExecStart=/home/zain/surfmind/surfmind-backend-staging/senv/bin/celery -A src.celery_app worker --loglevel=info
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
